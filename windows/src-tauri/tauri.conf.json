{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kumo",
  "version": "1.0.1",
  "identifier": "com.dadarnie.kumo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    },
    "windows": [
      {
        "label": "island",
        "title": "Kumo",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "theme": "Dark",
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/kumo-hook.exe": "kumo-hook.exe",
      "../../LICENSE": "licenses/LICENSE",
      "../../LICENSE-ASSETS.md": "licenses/LICENSE-ASSETS.md",
      "../../legal/ASSETS.md": "licenses/legal/ASSETS.md",
      "../../legal/NOTICE.md": "licenses/legal/NOTICE.md",
      "../src/assets/fonts/Inter-LICENSE.txt": "licenses/Inter-LICENSE.txt",
      "../src/assets/fonts/FiraCode-LICENSE.txt": "licenses/FiraCode-LICENSE.txt",
      "../src/assets/fonts/JetBrainsMono-LICENSE.txt": "licenses/JetBrainsMono-LICENSE.txt",
      "../src/mimo/brands/README.md": "licenses/INTEGRATION-ARTWORK.md",
      "../../THIRD_PARTY_NOTICES": "licenses/THIRD_PARTY_NOTICES",
      "../../legal/Coucou-MIT.txt": "licenses/legal/Coucou-MIT.txt",
      "../../legal/legacy/MIMO-ASSETS-MIT.md": "licenses/legal/legacy/MIMO-ASSETS-MIT.md"
    },
    "publisher": "John Paul",
    "copyright": "© John Paul",
    "category": "DeveloperTool",
    "shortDescription": "Kumo lives at the top of your screen",
    "longDescription": "Kumo lives at the top of your screen: follow Claude Code and Codex, keep music and integrations close, and approve, chat or share a file without leaving your work.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "French"
        ],
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
